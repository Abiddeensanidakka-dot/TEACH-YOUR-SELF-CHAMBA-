<script>
function filterTable(inputId,tableId){
 const q=document.getElementById(inputId).value.toLowerCase();
 const rows=document.querySelectorAll("#"+tableId+" tbody tr");
 rows.forEach(row=>row.style.display=row.innerText.toLowerCase().includes(q)?"":"none");
}
function speak(text){
 if(!("speechSynthesis" in window)){alert("Your browser does not support text-to-speech.");return;}
 speechSynthesis.cancel();
 const u=new SpeechSynthesisUtterance(text);
 u.rate=.8;
 speechSynthesis.speak(u);
}
const words=["Noni","Bara","Tará","Nasa","Tuna","Tunin","Dūgtin","Kum","Bāte","Gén","Woki","Tinusa","Tuki","Guu","Ding"];
document.getElementById("audioButtons").innerHTML=words.map(w=>`<button class="audio" onclick="speak('${w.replaceAll("'","\\\\'")}')">🔊 ${w}</button>`).join(" ");
</script>
